{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
  
    "require": {
        "php": "^8.1",
        "algolia/algoliasearch-client-php": "^3.4",
        "aws/aws-sdk-php-laravel": "^3.8",
        "barryvdh/laravel-dompdf": "^3.1",
        "caneara/axiom": "^3.2",
        "filament/tables": "^3.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "jantinnerezo/livewire-alert": "^3.0",
        "kreait/laravel-firebase": "^5.7",
        "laracasts/presenter": "^0.2",
        "laravel-notification-channels/fcm": "^3.2",
        "laravel/framework": "^10.0",
        "laravel/helpers": "^1.7",
        "laravel/legacy-factories": "^1.4",
        "laravel/sanctum": "^3.2",
        "laravel/scout": "^10.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.6",
        "laravel/vapor-cli": "^1.65",
        "laravel/vapor-core": "^2.36",
        "league/csv": "^9.7",
        "league/flysystem-aws-s3-v3": "^3.24",
        "livewire/livewire": "^3.4",
        "maatwebsite/excel": "^3.1",
        "nckg/laravel-impersonate": "^4.0",
        "predis/predis": "^2.0",
        "pusher/pusher-php-server": "^7.2",
        "santigarcor/laratrust": "^8.5",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-medialibrary": "^10.0",
        "stevebauman/purify": "^6.1",
        "symfony/http-client": "^6.0",
        "symfony/mailgun-mailer": "^6.0",
        "symfony/postmark-mailer": "^6.0",
        "symfony/process": "^6.4",
        "titasgailius/search-relations": "^2.0",
        "twilio/sdk": "^8.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "beyondcode/laravel-dump-server": "^1.9.0",
        "fakerphp/faker": "^1.9.1",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-web-tinker": "^1.8.4"
    },
    "autoload": {
        "psr-4": {
        "App\\": "app/",
        "Database\\Factories\\": "database/factories/",
        "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "config/school-plus.php",
            "app/Helpers/SiteHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
 
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover",
            "@php artisan filament:upgrade"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
